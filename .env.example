# Copy this file to .env and fill in real values. Never commit .env.

# Cursor API key used to authenticate SDK calls made by reviewers/architecture.py
# (the only real reviewer so far) and by the standalone verify_cursor_sdk.py
# connectivity check. Get a user key from
# https://cursor.com/dashboard/integrations, or a team service-account key
# from Team Settings -> Service accounts.
CURSOR_API_KEY=

# Optional: default model used by Cursor SDK-backed reviewers and by
# verify_cursor_sdk.py. See Cursor.models.list() (config.py, planned) for
# valid IDs available to your account.
REVIEWBOARD_MODEL=composer-2.5

# Optional: seconds the orchestrator pauses between reviewer steps so the
# workflow is visibly watchable in the dashboard (see config.py). Defaults
# to 0.8 if unset; set to 0 to disable the pause entirely.
REVIEW_STEP_DELAY_SECONDS=0.8
