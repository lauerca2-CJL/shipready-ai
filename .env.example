# Copy this file to .env and fill in real values. Never commit .env.

# Cursor API key used to authenticate all SDK calls made by the reviewer
# agents (once implemented), and by the standalone verify_cursor_sdk.py
# connectivity check (Sprint 5). Get a user key from
# https://cursor.com/dashboard/integrations, or a team service-account key
# from Team Settings -> Service accounts.
CURSOR_API_KEY=

# Optional: default model used by every reviewer agent unless overridden,
# and by verify_cursor_sdk.py. See Cursor.models.list() (config.py,
# planned) for valid IDs available to your account.
REVIEWBOARD_MODEL=composer-2.5

# Optional: seconds the orchestrator pauses between reviewer steps so the
# workflow is visibly watchable in the dashboard (see config.py). Defaults
# to 0.8 if unset; set to 0 to disable the pause entirely.
REVIEW_STEP_DELAY_SECONDS=0.8
