# Copy this file to .env and fill in real values. Never commit .env.

# Cursor API key used to authenticate all SDK calls made by the reviewer
# agents. Get a user key from https://cursor.com/dashboard/integrations,
# or a team service-account key from Team Settings -> Service accounts.
CURSOR_API_KEY=

# Optional: default model used by every reviewer agent unless overridden.
# See Cursor.models.list() (shipready_ai/config.py, planned) for valid IDs
# available to your account.
REVIEWBOARD_MODEL=composer-2.5
